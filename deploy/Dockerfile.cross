# Optional fast ARM64 compiler on an x86 Linux host. The Pi uses provision-llm.sh.
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake make g++-aarch64-linux-gnu git ca-certificates python3 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
CMD ["sh", "deploy/cross-llm.sh"]
